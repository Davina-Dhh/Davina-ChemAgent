# ChemAgent Lab — Streamlit Cloud Secrets 模板
# 在 https://share.streamlit.io → App settings → Secrets 粘贴：

OPENAI_API_KEY = "sk-your-agnes-or-openai-key"
OPENAI_API_BASE = "https://apihub.agnes-ai.com/v1"
CHEMCROW_MODEL = "agnes-2.5-flash"

# 专业反应模型：Token 配一次即可；URL 由本机 keep_t5_online 自动发布到发现链接
REACTIONT5_API_TOKEN = "与本机 .reactiont5_token 一致"
# 可不填 URL（推荐）
# REACTIONT5_DISCOVERY_URL = "https://cdn.jsdelivr.net/gh/Davina-Dhh/Davina-ChemAgent@main/static/t5_endpoint.json"

# 可选
RXN4CHEM_API_KEY = ""
